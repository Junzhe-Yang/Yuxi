{
  "base_url": "https://your-yuxi.example.com",
  "auth": {
    "mode": "login",
    "login_id_env": "YUXI_LOGIN_ID",
    "password_env": "YUXI_PASSWORD"
  },
  "agent_id": "MedicationReviewAcmPrimAgent",
  "input_file": "input.example.json",
  "output_dir": "../../outputs/acm-prim-rag-v3-top10",
  "concurrency": 1,
  "request_timeout_seconds": 60,
  "run_timeout_seconds": 1800,
  "max_attempts": 2,
  "max_sse_reconnects": 8,
  "sse_reconnect_delay_seconds": 1,
  "verify_tls": true,
  "write_raw_events": true,
  "allow_debug_stopped": false,
  "variants": {
    "acm_prim": {
      "agent_config_id": 501,
      "expected_knowledge_base_name": "我的向量知识库",
      "expected_method_family": "acm-prim-rag-v3",
      "expected_method_version": "acm-prim-rag-v3-atlas-navigation-vector-top10",
      "expected_effective_profile": "full",
      "expected_trace_schema_version": "10.0"
    }
  }
}
