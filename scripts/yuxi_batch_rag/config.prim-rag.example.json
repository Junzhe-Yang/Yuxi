{
  "base_url": "https://your-yuxi.example.com",
  "auth": {
    "mode": "login",
    "login_id_env": "YUXI_LOGIN_ID",
    "password_env": "YUXI_PASSWORD"
  },
  "agent_id": "MedicationReviewPrimAgent",
  "input_file": "input.example.json",
  "output_dir": "../../outputs/prim-rag-v2-top10-ablation",
  "concurrency": 1,
  "request_timeout_seconds": 60,
  "run_timeout_seconds": 1200,
  "max_attempts": 2,
  "max_sse_reconnects": 8,
  "sse_reconnect_delay_seconds": 1,
  "verify_tls": true,
  "write_raw_events": true,
  "allow_debug_stopped": false,
  "variants": {
    "b1_evidence_card": {
      "agent_config_id": 301,
      "expected_knowledge_base_name": "我的向量知识库",
      "expected_method_family": "prim-rag-v2",
      "expected_method_version": "prim-rag-v2-b1-vector-top10",
      "expected_experiment_profile": "b1",
      "expected_effective_profile": "b1",
      "expected_trace_schema_version": "8.0"
    },
    "m1_plan_nodes": {
      "agent_config_id": 302,
      "expected_knowledge_base_name": "我的向量知识库",
      "expected_method_family": "prim-rag-v2",
      "expected_method_version": "prim-rag-v2-m1-vector-top10",
      "expected_experiment_profile": "m1",
      "expected_effective_profile": "m1",
      "expected_trace_schema_version": "8.0"
    },
    "m2_plan_modifier_nodes": {
      "agent_config_id": 303,
      "expected_knowledge_base_name": "我的向量知识库",
      "expected_method_family": "prim-rag-v2",
      "expected_method_version": "prim-rag-v2-m2-vector-top10",
      "expected_experiment_profile": "m2",
      "expected_effective_profile": "m2",
      "expected_trace_schema_version": "8.0"
    },
    "m3_evidence_investigation": {
      "agent_config_id": 304,
      "expected_knowledge_base_name": "我的向量知识库",
      "expected_method_family": "prim-rag-v2",
      "expected_method_version": "prim-rag-v2-m3-vector-top10",
      "expected_experiment_profile": "m3",
      "expected_effective_profile": "m3",
      "expected_trace_schema_version": "8.0"
    },
    "full_investigation_reflection": {
      "agent_config_id": 305,
      "expected_knowledge_base_name": "我的向量知识库",
      "expected_method_family": "prim-rag-v2",
      "expected_method_version": "prim-rag-v2-full-vector-top10",
      "expected_experiment_profile": "full",
      "expected_effective_profile": "full",
      "expected_trace_schema_version": "8.0"
    }
  }
}
