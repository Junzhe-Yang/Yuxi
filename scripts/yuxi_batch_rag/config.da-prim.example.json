{
  "base_url": "https://your-yuxi.example.com",
  "auth": {
    "mode": "login",
    "login_id_env": "YUXI_LOGIN_ID",
    "password_env": "YUXI_PASSWORD"
  },
  "agent_id": "MedicationReviewDaPrimAgent",
  "input_file": "input.example.json",
  "output_dir": "../../outputs/da-prim-rag-v1-ablation",
  "concurrency": 1,
  "request_timeout_seconds": 60,
  "run_timeout_seconds": 1800,
  "max_attempts": 2,
  "max_sse_reconnects": 8,
  "sse_reconnect_delay_seconds": 1,
  "verify_tls": true,
  "write_raw_events": true,
  "allow_debug_stopped": false,
  "variants": {
    "atlas_map": {
      "agent_config_id": 401,
      "expected_knowledge_base_name": "我的向量知识库",
      "expected_method_family": "da-prim-rag-v1",
      "expected_atlas_profile": "map",
      "expected_trace_schema_version": "6.0"
    },
    "atlas_route": {
      "agent_config_id": 402,
      "expected_knowledge_base_name": "我的向量知识库",
      "expected_method_family": "da-prim-rag-v1",
      "expected_atlas_profile": "route",
      "expected_trace_schema_version": "6.0"
    },
    "da_prim_full": {
      "agent_config_id": 403,
      "expected_knowledge_base_name": "我的向量知识库",
      "expected_method_family": "da-prim-rag-v1",
      "expected_atlas_profile": "full",
      "expected_trace_schema_version": "6.0"
    }
  }
}
